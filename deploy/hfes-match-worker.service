[Unit]
Description=HFE Peapod embedding worker (warm model + UMAP; ~1 s placements)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=hfesmatch
Group=hfesmatch
WorkingDirectory=/opt/hfes-match
EnvironmentFile=/etc/hfes-match.env
ExecStart=/opt/hfes-match/.venv/bin/python /opt/hfes-match/embed_umap.py worker --socket /opt/hfes-match/state/worker.sock
Restart=always
RestartSec=3
# Safety net on the 2 GB t3.small: if a job ever balloons, systemd kills just this process and
# restarts it; server.py sees the socket drop mid-job and redoes that job in a cold subprocess.
MemoryMax=1300M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/hfes-match/state

[Install]
WantedBy=multi-user.target
